@page "/"
@inject IJSRuntime JS

<MapList @ref="mapList" OnMapItemClick="OnMapItemClickAsync" OnClear="OnClearAsync" MainPage="this"/>

<div class="info">
    <MapInfo @ref="mapInfo" OnDownloadConversion="OnDownloadAsync" />

    @if (mapList?.Maps.Count > 0)
    {
        <button class="big" @onclick="OnDownloadAllAsync" disabled="@(!mapList.Maps.Any(x => x.Successful))">Download all conversions</button>
    }
</div>

@code {
    private MapList? mapList;
    private MapInfo? mapInfo;

    public void Update()
    {
        StateHasChanged();
    }

    public async Task OnMapItemClickAsync(MapItem mapItem)
    {
        if (mapInfo is not null)
        {
            await mapInfo.ShowAsync(mapItem);
        }
    }

    public async Task OnClearAsync()
    {
        if (mapInfo is not null)
        {
            await mapInfo.Close();
        }
    }

    public async Task OnDownloadAsync()
    {
        var map = mapList?.Maps.FirstOrDefault(x => x.Selected);

        if (map is null || map.Map is null || !map.Successful)
        {
            return;
        }

        using var ms = new MemoryStream();
        map.Map.Save(ms);

        await DownloadAsync(ReplaceExtension(map.FileName), ms);
    }

    public async Task OnDownloadAllAsync()
    {
        if (mapList is null || mapList.Maps.Count == 0)
        {
            return;
        }

        var successfulMapCount = mapList.Maps.Count(x => x.Successful);

        if (successfulMapCount == 0)
        {
            return;
        }

        using var ms = new MemoryStream();

        if (successfulMapCount == 1)
        {
            var map = mapList.Maps.First(x => x.Successful);

            if (map.Map is not null && map.Successful)
            {
                map.Map.Save(ms);
                await DownloadAsync(ReplaceExtension(map.FileName), ms);
            }

            return;
        }

        using (var zip = new ZipArchive(ms, ZipArchiveMode.Create))
        {
            foreach (var map in mapList.Maps)
            {
                if (map.Map is null || !map.Successful)
                {
                    continue;
                }

                using var stream = zip.CreateEntry(ReplaceExtension(map.FileName)).Open();

                map.Map.Save(stream);
            }
        }

        await DownloadAsync($"Conversion-{DateTime.Now.ToString("yyyyMMddHHmmss")}.zip", ms);
    }

    private string ReplaceExtension(string originalFileName)
    {
        if (originalFileName.EndsWith(".Challenge.Gbx"))
        {
            return originalFileName.Replace(".Challenge.Gbx", ".Map.Gbx");
        }

        return originalFileName;
    }

    private async Task DownloadAsync(string name, byte[] data)
    {
        await JS.InvokeVoidAsync("download", name, data);
    }

    private async Task DownloadAsync(string name, MemoryStream stream)
    {
        await DownloadAsync(name, stream.ToArray());
    }
}