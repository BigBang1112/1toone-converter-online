@using GBX.NET.Engines.Game

@implements IDisposable

@inject IJSRuntime JS
@inject ISettingsService Settings
@inject IConversionService Conversion

<div class="list" id="filedrop">
    <div class="controls">
        <header>
            <div>@Maps.Count(x => x.Successful)/@Maps.Count maps converted</div>
        </header>
        <fieldset class="interpolation-selector" aria-label="Camera interpolation">
            <legend>Camera interpolation</legend>
            <input type="radio" id="interpolation-linear" name="interpolation" value="Linear" checked="@(cameraInterpolation == CameraInterpolation.Linear)" @onchange="() => cameraInterpolation = CameraInterpolation.Linear" />
            <label for="interpolation-linear" title="Camera interpolation mode. Linear is suitable for most maps.">Linear</label>
            <input type="radio" id="interpolation-hermite" name="interpolation" value="Hermite" checked="@(cameraInterpolation == CameraInterpolation.Hermite)" @onchange="() => cameraInterpolation = CameraInterpolation.Hermite" />
            <label for="interpolation-hermite" title="Camera interpolation mode. Hermite works better for certain maps.">Hermite</label>
        </fieldset>
        <footer>
            <div class="btn" @onclick="ClearAsync">Clear</div>
            <!-- <div class="btn">Settings</div> -->
        </footer>
    </div>
    <ul>
        <li class="add">
            <form
                method="post"
                action=""
                enctype="multipart/form-data"
            >
                <label for="file">
                    <header>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 16 16"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"
                            />
                        </svg>
                    </header>
                    <input
                        type="file"
                        name="files[]"
                        id="file"
                        accept=".gbx"
                        multiple
                    />
                    <footer>
                        <strong>Choose a file</strong> or drag
                        it in here
                    </footer>
                </label>
            </form>
        </li>

        @foreach (var map in Maps)
        {
            <li class="item @map.BasicInfo?.Environment?.ToLower() @(map.Selected ? "selected" : "")" @onclick="() => OnMapItemClickAsync(map)">
                <header>@(map.Map is null ? map.FileName : map.Name)</header>
                <footer>@(map.Description ?? (map.Map is null ? $"Loading... ({map.FileSize} bytes)" : "Preparing..."))</footer>
            </li>
        }
    </ul>
</div>

@code {
    private DotNetObjectReference<MapList>? objRef;
    private CameraInterpolation cameraInterpolation = CameraInterpolation.Linear;

    public List<MapItem> Maps { get; } = new();

    [Parameter]
    public EventCallback<MapItem> OnMapItemClick { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }

    [Parameter]
    public Pages.Index? MainPage { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        objRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("start", objRef);
    }

    public async Task ClearAsync()
    {
        Maps.Clear();

        await OnClear.InvokeAsync();
    }

    public async Task OnMapItemClickAsync(MapItem mapItem)
    {
        foreach (var item in Maps)
        {
            item.Selected = false;
        }

        mapItem.Selected = true;

        await OnMapItemClick.InvokeAsync(mapItem);
    }

    [JSInvokable]
    public async Task OnUploadAsync(string name, int size, long lastModified, byte[] data)
    {
        var mapItem = new MapItem(name, size, DateTimeOffset.FromUnixTimeMilliseconds(lastModified));
        mapItem.CameraInterpolation = cameraInterpolation;

        Maps.Insert(0, mapItem);

        StateHasChanged();
        await Task.Delay(10);

        using var ms = new MemoryStream(data);
        var node = await GBX.NET.Gbx.ParseNodeAsync(ms);

        if (node is not CGameCtnChallenge map)
        {
            mapItem.Description = $"File isn't a map.";

            StateHasChanged();
            return;
        }

        mapItem.Map = map;
        mapItem.BasicInfo = new MapBasicInfo(map);

        if (Settings.MainSettings?.Environments is null)
        {
            mapItem.Description = $"Environments are not defined in Settings.json!";

            StateHasChanged();
            return;
        }

        if (!Settings.MainSettings.Environments.Contains(map.Collection.ToString()))
        {
            mapItem.Description = $"The map's environment '{map.Collection}' doesn't match: {string.Join(", ", Settings.MainSettings.Environments)}";

            StateHasChanged();
            return;
        }

        if (map.CreatedWithSimpleEditor)
        {
            mapItem.Description = "The map was created with the simple editor, which is not supported.";

            StateHasChanged();
            return;
        }

        await OnMapItemClick.InvokeAsync(mapItem);

        mapItem.Description = "Converting...";

        StateHasChanged();
        await Task.Delay(10);

        // Passes the same map reference, so variable `map` is the final result.
        Conversion.Convert(new Map(mapItem.Map)
        {
            CameraInterpolation = mapItem.CameraInterpolation,
        });

        mapItem.Description = "Finished!";
        mapItem.Successful = true;

        foreach (var item in Maps)
        {
            item.Selected = false;
        }

        mapItem.Selected = true;

        MainPage?.Update();
    }
    
    public void Dispose()
    {
        objRef?.Dispose();
    }
}
