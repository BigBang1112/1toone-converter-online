@using GBX.NET.Engines.Game

@implements IDisposable

@inject IJSRuntime JS
@inject ISettingsService Settings
@inject IConversionService Conversion

<div class="list" id="filedrop">
    <div class="controls">
        <header>
            <div>@Maps.Count(x => x.Successful)/@Maps.Count maps converted</div>
        </header>
        <footer>
            <div class="btn" @onclick="ClearAsync">Clear</div>
            <div class="btn">Settings</div>
        </footer>
    </div>
    <ul>
        <li class="add">
            <form
                method="post"
                action=""
                enctype="multipart/form-data"
            >
                <label for="file">
                    <header>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 16 16"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"
                            />
                        </svg>
                    </header>
                    <input
                        type="file"
                        name="files[]"
                        id="file"
                        accept=".gbx"
                        multiple
                    />
                    <footer>
                        <strong>Choose a file</strong> or drag
                        it in here
                    </footer>
                </label>
            </form>
        </li>

        @foreach (var map in Maps)
        {
            <li class="item @map.BasicInfo?.Environment.ToLower() @(map.Selected ? "selected" : "")" @onclick="() => OnMapItemClickAsync(map)">
                <header>@(map.Map is null ? map.FileName : map.Name)</header>
                <footer>@(map.Description ?? (map.Map is null ? $"Loading... ({map.FileSize} bytes)" : "Preparing..."))</footer>
            </li>
        }
    </ul>
</div>

@code {
    private DotNetObjectReference<MapList>? objRef;

    public List<MapItem> Maps { get; } = new();

    [Parameter]
    public EventCallback<MapItem> OnMapItemClick { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        objRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("start", objRef);
    }

    public async Task ClearAsync()
    {
        Maps.Clear();

        await OnClear.InvokeAsync();
    }

    public async Task OnMapItemClickAsync(MapItem mapItem)
    {
        Maps.ForEach(x => x.Selected = false);

        mapItem.Selected = true;

        await OnMapItemClick.InvokeAsync(mapItem);
    }

    [JSInvokable]
    public async Task OnUploadAsync(string name, int size, DateTimeOffset lastModifiedDate, byte[] data)
    {
        var mapItem = new MapItem(name, size, lastModifiedDate);

        Maps.Insert(0, mapItem);

        StateHasChanged();
        await Task.Delay(10);

        using var ms = new MemoryStream(data);
        using var node = await GBX.NET.GameBox.ParseNodeAsync(ms);

        if (node is not CGameCtnChallenge map)
        {
            mapItem.Description = $"File isn't a map.";

            StateHasChanged();
            return;
        }

        mapItem.Map = map;
        mapItem.BasicInfo = new MapBasicInfo(map);

        if (Settings.MainSettings?.Environments is null)
        {
            mapItem.Description = $"Environments are not defined in Settings.json!";

            StateHasChanged();
            return;
        }

        if (!Settings.MainSettings.Environments.Contains(map.Collection.ToString()))
        {
            mapItem.Description = $"The map's environment '{map.Collection}' doesn't match: {string.Join(", ", Settings.MainSettings.Environments)}";

            StateHasChanged();
            return;
        }

        await OnMapItemClick.InvokeAsync(mapItem);

        mapItem.Description = "Converting...";

        StateHasChanged();
        await Task.Delay(10);

        // Passes the same map reference, so variable `map` is the final result.
        Conversion.Convert(new Map(mapItem.Map));

        mapItem.Description = "Finished!";
        mapItem.Successful = true;

        StateHasChanged();
    }
    
    public void Dispose()
    {
        objRef?.Dispose();
    }
}