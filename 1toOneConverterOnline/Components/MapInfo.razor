@if (MapItem is not null)
{
    @if (MapItem.ThumbnailBase64 is null)
    {
        <img src="" alt="" />
    }
    else
    {
        <img src="data:image/png;base64,@MapItem.ThumbnailBase64" alt="" />
    }
    <ul>
        <li>@(MapItem.Name ?? MapItem.FileName)</li>
                
        @if (MapItem.BasicInfo is not null)
        {

        <li><span>Author</span><span>@MapItem.BasicInfo.AuthorName</span></li>
        <li><span>Time</span><span>@MapItem.BasicInfo.AuthorTime.ToTmString(useHundredths: true)</span></li>
        <li><span>Mood</span><span>@MapItem.BasicInfo.Mood</span></li>
        <li><span>Car</span><span>@MapItem.BasicInfo.Car</span></li>

        @if (MapItem.Map?.Cost is not null)
        {
            <li><span>Cost</span><span>@MapItem.Map.Cost.Value</span></li>
        }

        @if (MapItem.BasicInfo.BlockCount.HasValue)
        {
            <li><span>Blocks</span><span>@MapItem.BasicInfo.BlockCount</span></li>
        }

        <li><button class="big">Download conversion</button></li>
                
        }

    </ul>
}

@code {
    public MapItem? MapItem { get; private set; }

    public Task ShowAsync(MapItem mapItem)
    {
        MapItem = mapItem;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task Close()
    {
        MapItem = null;
        StateHasChanged();
        return Task.CompletedTask;
    }
}