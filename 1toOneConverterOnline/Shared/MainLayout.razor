@inherits LayoutComponentBase

@inject ISettingsService Settings

@if (IsLoaded)
{
    <section id="content">
        <nav>
            <NavMenu />
        </nav>

        <main>
            @Body
        </main>
    </section>

    <footer style="display: flex; align-items: center; justify-content: center; color: #7186a8">
        Converter by BigBang1112, UI by thaumictom | Version: @ThisAssembly.Info.InformationalVersion
    </footer>
}
else
{
    <div style="display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 1rem; height: 100vh;">
        <p>@StatusMessage</p>
        <p>Almost there...</p>
    </div>
}

@code {
    public bool IsLoaded { get; set; }
    public string StatusMessage { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        await Settings.LoadMainSettingsAsync();
        await Settings.LoadConversionSettingsAsync(async (env) =>
        {
            StatusMessage = $"Loading {env}Conversion.xml...";
            await Task.Delay(10);
            StateHasChanged();
        });

        IsLoaded = true;
    }
}